# ==========================================
# VoiceHire Configuration
# Copy this file to .env and fill in values
# ==========================================

# Environment (development, production)
ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# CORS (Allowed Origins - JSON array or wildcard)
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:80", "http://localhost"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# ==========================================
# Future Integrations (Phase 1+ Configuration)
# ==========================================

# LiveKit Credentials
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret

# LLM Providers (OpenAI, Anthropic, Gemini, etc.)
# OPENAI_API_KEY=your-openai-key
# GEMINI_API_KEY=your-gemini-key

# Voice Providers (STT / TTS)
# DEEPGRAM_API_KEY=your-deepgram-key
# ELEVEN_LABS_API_KEY=your-elevenlabs-key

# Database
# MONGODB_URI=mongodb://localhost:27017/voicehire
